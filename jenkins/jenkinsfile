pipeline {
    agent {
        label 'build'
    } 

    tools {
      maven 'maven'
    }
    
    environment {
        DOCKER_CREDS = credentials('dockercreds')
        SCANNER_HOME = tool 'sonar-scanner'
    }
    stages {
        stage("Clean Workspace") { 
            steps {
                cleanWs()
            }
        }

        stage("AppCode Checkout"){
            steps{
                git branch:"nexus", url:"https://github.com/prateekkumawat/jenkins-weekend-repo.git"
            }
        }

        stage("SonarAnalysis"){
            steps{
                dir('springapp/'){
                    withSonarQubeEnv('sonar-server') {
                      sh ''' mvn clean verify sonar:sonar \
                      -Dsonar.projectName=springapp-learning-basic \
                      -Dsonar.projectKey=springapp-learning-basic '''
                    }
                }     
            }
        }   

        stage("Sonar QualityGate"){
            steps{
                script {
                  waitForQualityGate abortPipeline: false, credentialsId: 'sonar-token' 
                }
            }
        }
        
        stage("Artifacts Upload"){
            steps{
                nexusArtifactUploader (
                    nexusVersion: 'nexus3',
                    protocol: 'http',
                    nexusUrl: 'http://13.233.125.54:8081/repository/maven-releases/',
                    groupId: 'com.example',
                    version: 0.0.2-SNAPSHOT,
                    repository: 'nexus-releases',
                    credentialsId: 'nexus',
                    artifacts: [
                        [artifactId: demo,
                        classifier: '',
                        file: 'demo' + version + '.jar',
                        type: 'jar']
                    ]    
                )    
            }
        }

        stage("Build Image") {
            steps {
               sh 'docker build -t prateekkumawat/jenkinsimage:springapp-${BUILD_NUMBER} . '
            }
        }
        
        stage("push Image"){
          steps {
               sh 'docker login -u $DOCKER_CREDS_USR -p $DOCKER_CREDS_PSW '
               sh ' docker push prateekkumawat/jenkinsimage:springapp-${BUILD_NUMBER} '
          }
        }

        stage("Notification"){
            steps {
                sh ' echo " Hello slack notification msg send" '
            }
        }
    }
}